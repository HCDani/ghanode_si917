define:
- name: SL_SI91X_PRINT_DBG_LOG
- name: SLI_SI91X_EMBEDDED_MQTT_CLIENT
- name: SL_MQTT_CLIENT_MAX_RX_PAYLOAD_SIZE
  value: '5120'
# Unlocks the configuration block in sl_si91x_adc_init_channel_1_config.h, which
# is compiled out otherwise. Equivalent to the "Enable User Configuration"
# component, which slc does not pick up from the component list.
- name: USER_CONFIGURATION_ENABLE
  value: '1'
requires:
- name: device_needs_ram_execution
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
